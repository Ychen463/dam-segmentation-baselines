# --- Secrets ---
*.pem
*.key
my\ gpu\ key.pem

# --- Datasets (922 MB) ---
Dataset/

# --- Training checkpoints (large, 100s of MB each) ---
# NOTE: runs/ itself is NOT ignored — we want metrics.csv, test_report.txt,
# curves.png, and samples/*.png to be tracked so Claude can read results
# from RunPod after `git pull`. Only the heavy checkpoint files are blocked.
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
wandb/
lightning_logs/
tb_logs/

# --- Virtual envs (~1 GB) ---
.venv/
**/.venv/
venv/
env/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- LaTeX build artifacts ---
*.aux
*.log
*.out
*.spl
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# --- Compiled PDFs (rebuild from .tex) ---
workspace/final/*.pdf

# --- Cached features (large) ---
*.npy

# --- OS / IDE ---
.DS_Store
.idea/
.vscode/

# --- Claude Code workspace ---
.claude/
